# API Workbench runtime configuration
# Edit these values from Settings > Environment Variables.

# Open Electron DevTools for the local development app only
ELECTRON_OPEN_DEVTOOLS=true

# Login password encryption key
OPENAPI_PWD_ENC_KEY=

# OAuth2 client credentials
OPENAPI_OAUTH_CLIENT_ID=
OPENAPI_OAUTH_CLIENT_SECRET=

# Login and user information paths
OPENAPI_LOGIN_PATH=/auth/oauth2/token
OPENAPI_USER_INFO_PATH=/admin/user/info

# Default business URL prefix
OPENAPI_URL_PREFIX=/platform

# Default OpenAPI document URL
OPENAPI_DEFAULT_API_URL=http://127.0.0.1:4523/export/openapi/5?version=3.0

# Timeouts in milliseconds
OPENAPI_FETCH_TIMEOUT=30000
OPENAPI_INVOKE_TIMEOUT=30000
OPENAPI_CONFIG_TIMEOUT=30000
OPENAPI_RESPONSE_TRUNCATE_THRESHOLD=10000
