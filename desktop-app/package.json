{
  "name": "codex-dream-skin-desktop",
  "version": "0.1.4",
  "description": "Codex Dream Skin desktop application",
  "author": "Codex Dream Skin",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron --import=tsx electron/main.ts\"",
    "skin:inject": "bash scripts/skin-inject.sh",
    "skin:pause": "bash scripts/skin-pause.sh",
    "changelog": "node scripts/generate-changelog.mjs",
    "postversion": "npm run changelog",
    "prebuild": "npm version patch --no-git-tag-version --ignore-scripts && npm run changelog",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.electron.json && node electron/copy-preload.mjs && electron-builder",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.19.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "element-plus": "^2.9.11",
    "highlight.js": "^11.11.1",
    "pinia": "^2.3.1",
    "pinyin": "^4.0.0",
    "vue": "^3.5.17",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.15.21",
    "@types/pinyin": "^2.10.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.15.6",
    "sass": "^1.102.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^0.17.8",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^7.0.6",
    "vue-tsc": "^2.2.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "local.codex.dreamskin.desktop",
    "productName": "Codex Dream Skin",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist-ui",
      "dist-electron",
      "assets",
      ".env.example"
    ],
    "extraResources": [
      {
        "from": "../windows",
        "to": "platform/windows"
      },
      {
        "from": "../macos",
        "to": "platform/macos"
      },
      {
        "from": "electron/platform",
        "to": "platform/bridge"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/dream-skin.ico",
      "artifactName": "Codex-Dream-Skin-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "Codex-Dream-Skin-${version}.${ext}"
    }
  }
}
